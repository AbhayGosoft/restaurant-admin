DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/staypms"
PORT=4000
NODE_ENV=development
JWT_SECRET="change-this-long-random-secret-before-production"
JWT_EXPIRES_IN="7d"
# Public origin this API is actually reachable at — used to turn backend-relative upload
# paths (/uploads/images/...) into absolute URLs for external consumers like GoAdapter.
# Defaults to http://localhost:$PORT if unset, which is wrong for any deployed environment.
PUBLIC_ORIGIN="https://appconnector.bharatotel.com"
# Web origins, plus the Capacitor WebView origins used by the packaged app
# (https://localhost for Android since androidScheme is "https", capacitor://localhost for iOS).
FRONTEND_ORIGIN="http://localhost:3000,https://appconnector.bharatotel.com,https://localhost,capacitor://localhost"
REDIS_URL="redis://127.0.0.1:6379"
LOG_LEVEL="info"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
SAAS_ADAPTER_API_KEY=""
SAAS_ADAPTER_HMAC_SECRET=""
SAAS_ADAPTER_CALLBACK_URL=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Or use FIREBASE_SERVICE_ACCOUNT_JSON instead of the three Firebase fields above.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Shared secret the web/app frontend must send as the x-client-key header.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_CLIENT_KEY=""
