# Copy this file to `.env` on the server and fill in real values. Never commit the
# filled-in `.env` itself — only this placeholder template belongs in git.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/restaurant_backend"
PORT=4001
NODE_ENV=production

JWT_SECRET="generate-with-node-crypto-randomBytes-32-hex"
JWT_EXPIRES_IN="7d"
CUSTOMER_JWT_SECRET="generate-a-different-random-secret-than-JWT_SECRET"
CUSTOMER_ACCESS_TOKEN_TTL="15m"
CUSTOMER_REFRESH_TOKEN_TTL_DAYS=30

PUBLIC_ORIGIN="https://restaurant-api.bharatotel.com"
FRONTEND_ORIGIN="https://restaurant.bharatotel.com,https://darshan.bharatotel.com,https://localhost,capacitor://localhost"

REDIS_URL="redis://127.0.0.1:6379"
REDIS_PASSWORD="set-a-strong-redis-password"
LOG_LEVEL="info"

SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""

# Darshan Admin (central auth) bridge — see RESTAURANT_CENTRAL_AUTH_SPEC.md.
RESTAURANT_APP_API_KEY="generate-with-node-crypto-randomBytes-32-hex"
CENTRAL_AUTH_JWKS_URL="https://darshanadmin.bharatotel.com/api/darshan/auth/jwks.json"
CENTRAL_AUTH_ISSUER="https://darshanadmin.bharatotel.com"
CENTRAL_AUTH_AUDIENCE="bharatotel-modules"

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RESTAURANT_BOOKING_ADVANCE_INR=99

ONESIGNAL_APP_ID=""
ONESIGNAL_API_KEY=""

BOOKING_MODIFICATION_CUTOFF_MINUTES=60
BOOKING_REMINDER_MINUTES_BEFORE=120

APP_CLIENT_KEY="generate-with-node-crypto-randomBytes-32-hex"
