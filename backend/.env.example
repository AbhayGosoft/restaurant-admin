DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/restaurant_backend"
PORT=4000
NODE_ENV=development

# Admin/SuperAdmin JWT signing secret.
JWT_SECRET="change-this-long-random-secret-before-production"
JWT_EXPIRES_IN="7d"

# Restaurant customer JWT signing secret (kept separate from the admin secret so an
# admin token can never be replayed against a customer-only endpoint or vice versa).
CUSTOMER_JWT_SECRET="change-this-long-random-secret-before-production"
CUSTOMER_ACCESS_TOKEN_TTL="15m"
CUSTOMER_REFRESH_TOKEN_TTL_DAYS=30

# Where uploaded assets (/uploads/images/...) are actually reachable from.
PUBLIC_ORIGIN="http://localhost:4000"
FRONTEND_ORIGIN="http://localhost:3000,https://localhost,capacitor://localhost"

REDIS_URL="redis://127.0.0.1:6379"
LOG_LEVEL="info"

# Seed / create-admin script credentials.
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""

# Firebase Admin SDK — used to verify customer phone-auth ID tokens server-side.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Or use FIREBASE_SERVICE_ACCOUNT_JSON instead of the three Firebase fields above.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Razorpay — booking advance payment. Leave blank in local/dev to run the payment
# routes in a mock-friendly mode (order id is synthesized, signature check is skipped
# with a clear warning) so the flow is still testable end-to-end without live keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# The fixed advance amount (INR) charged for every restaurant booking. Controlled
# server-side only — never trust a client-provided amount.
RESTAURANT_BOOKING_ADVANCE_INR=99

# OneSignal — customer push notifications (booking confirmed/modified/cancelled/reminder).
# Left blank, notification sends are logged and skipped instead of failing the request.
ONESIGNAL_APP_ID=""
ONESIGNAL_API_KEY=""

# Booking modification cutoff, in minutes before the booked slot time, after which a
# booking may no longer be modified via PATCH /api/restaurant-bookings/:id/.
BOOKING_MODIFICATION_CUTOFF_MINUTES=60

# How long before a booking's slot time to fire the OneSignal reminder push.
BOOKING_REMINDER_MINUTES_BEFORE=120

# Shared secret the admin web frontend must send as the x-client-key header.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_CLIENT_KEY=""
